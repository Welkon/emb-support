# Python bytecode: regenerated on import and version-specific (cpython-3xx), so it
# belongs to whoever ran the script rather than to the repository.
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Editor and OS leftovers.
.DS_Store

# Tool caches that must not be published with a skill bundle.
.magpie-library

# Linter and test caches.
.ruff_cache/
